{
  "$schema": "https://developers.raycast.com/schemas/extension.json",
  "name": "quicktasks",
  "title": "Quicktasks",
  "description": "Fire and manage one-shot headless Claude Code tasks from qt",
  "icon": "icon.png",
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "quick-tasks",
      "title": "Quick Tasks",
      "description": "Browse recent quicktasks, resume blocked sessions, rerun or delete tasks",
      "mode": "view"
    },
    {
      "name": "new-quick-task",
      "title": "New Quick Task",
      "description": "Queue a new quicktask",
      "mode": "no-view",
      "arguments": [
        {
          "name": "prompt",
          "type": "text",
          "placeholder": "what should claude do?",
          "required": true
        },
        {
          "name": "dir",
          "type": "text",
          "placeholder": "run dir (optional)",
          "required": false
        }
      ]
    }
  ],
  "preferences": [
    {
      "name": "qtPath",
      "type": "textfield",
      "title": "qt Binary Path",
      "description": "Path to the qt binary",
      "default": "~/.local/bin/qt",
      "placeholder": "~/.local/bin/qt",
      "required": false
    },
    {
      "name": "dataDir",
      "type": "textfield",
      "title": "Quicktasks Data Directory",
      "description": "Directory holding quicktasks state (tasks, logs)",
      "default": "~/.quicktasks",
      "placeholder": "~/.quicktasks",
      "required": false
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.99.3",
    "@raycast/utils": "^1.19.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix -r",
    "lint": "ray lint -r"
  }
}
