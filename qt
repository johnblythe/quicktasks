#!/usr/bin/env python3
"""qt: fire-and-forget quicktasks for Claude Code.

Queue a one-shot task from anywhere, get a desktop notification when it
finishes. No session to babysit; every run is recorded in a ledger and
can be reopened later with `qt resume <id>`.

Data lives in ~/.quicktasks (override with QT_DATA). Dependencies:
python3 and the claude CLI. Notifications use terminal-notifier when
installed (app-style, clickable), else osascript. `qt setup` configures
the preferred terminal for resume, the trusted-dir list, and permission
mode. `qt doctor` is a read-only check that everything is wired up.

Permissions model:
- Default: headless runs use --permission-mode from QT_PERMISSIONS
  (acceptEdits). In print mode Claude cannot prompt, so tool calls
  outside the mode/allowlist are auto-denied.
- A denied run is marked "blocked" and raises a clickable notification
  (or a dialog without terminal-notifier) that reopens the session in
  the user's preferred terminal, where the denied action can be
  approved interactively so the task finishes.
- Trusted dirs: the user can explicitly mark directories via
  `qt trust <dir>` or `qt setup`. Tasks running in a trusted dir run in
  that dir itself under "trusted_permissions" (default "auto": a model
  approves safe tool calls and denies risky ones; set it to
  "bypassPermissions" to skip approval entirely). The trusted list is
  empty until the user adds to it; escalation is always user-configured,
  never a default.
"""

import datetime
import json
import os
import plistlib
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time

QT_DATA = os.path.expanduser(os.environ.get("QT_DATA", "~/.quicktasks"))
TASKS_DIR = os.path.join(QT_DATA, "tasks")
LOGS_DIR = os.path.join(QT_DATA, "logs")
RESUME_LOG = os.path.join(LOGS_DIR, "resume.log")
RESUME_LOG_MAX_LINES = 200
WORKSPACE = os.path.join(QT_DATA, "workspace")
TMP_DIR = os.path.join(QT_DATA, "tmp")
CONFIG_PATH = os.path.join(QT_DATA, "config.json")
TIMEOUT = int(os.environ.get("QT_TIMEOUT", "1800"))
MODEL = os.environ.get("QT_MODEL", "")
# Permission mode for non-trusted runs. Resolution: QT_PERMISSIONS env >
# config.json "permissions" > acceptEdits. Users who want classifier-driven
# approvals can set "permissions": "auto" in their config: a model
# (Sonnet 5) approves safe tool calls and denies risky ones, with no prompt
# fallback in headless. Auto requires a session model that supports it
# (Sonnet 4.6+/Opus 4.6+/Fable 5); unsupported models (e.g. Haiku) silently
# downgrade to Manual, which in headless denies everything non-allowlisted.
PERMISSIONS_ENV = os.environ.get("QT_PERMISSIONS")
HUB_DIR_ENV = os.environ.get("QT_HUB")
# Which UI surface fired this quick task, for the hub's own attribution.
# Read once at queue() time and stamped on the task; each surface sets
# QT_ORIGIN itself rather than qt taking a new CLI flag. Unknown/unset
# values fall back to "qt" -- a typo in a surface's env var should never
# block a task.
ORIGIN_ENV = os.environ.get("QT_ORIGIN")
QT_ORIGINS = ("qt", "raycast", "widget", "summon")


def resolve_permissions():
    return PERMISSIONS_ENV or load_config().get("permissions") or "acceptEdits"


def resolve_trusted_permissions():
    return load_config().get("trusted_permissions") or "auto"


def resolve_hub_dir():
    """QT_HUB env overrides config.json's "hub_dir"; unset means the hub
    feed is off and run_task() behaves exactly as it always has."""
    d = HUB_DIR_ENV or load_config().get("hub_dir")
    return os.path.realpath(os.path.expanduser(d)) if d else None

WORKSPACE_CLAUDE_MD = """\
# Quicktask runner

You are executing a one-shot, unattended task. No user is watching and
nobody can answer questions.

- Never ask for clarification. Make the most reasonable assumption and
  state it in your final message.
- Lead your final message with the outcome in one or two sentences. It
  becomes a desktop notification, so the first line must stand alone.
- Do exactly what the task says. Do not expand scope.
- If the task references "this repo" or "current directory", use the
  invocation directory noted at the end of the prompt.
- Save artifacts where the task says; otherwise save them in this
  directory and name the path in your final message.
- If a tool call is denied by permissions, do not look for another way
  to do the same thing. Stop that line of work and report exactly what
  was blocked; the user gets offered a resume to approve it.
- If the task cannot be completed, say exactly what is missing in one
  sentence.
"""


# --- config -------------------------------------------------------------

def load_config():
    if os.path.exists(CONFIG_PATH):
        with open(CONFIG_PATH) as f:
            return json.load(f)
    return {}


def save_config(cfg):
    os.makedirs(QT_DATA, exist_ok=True)
    tmp = CONFIG_PATH + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=2)
    os.replace(tmp, CONFIG_PATH)


def trusted_dirs():
    return [
        os.path.realpath(os.path.expanduser(d))
        for d in load_config().get("trusted_dirs", [])
    ]


def is_trusted(path):
    p = os.path.realpath(os.path.expanduser(path))
    for t in trusted_dirs():
        if p == t or p.startswith(t + os.sep):
            return True
    return False


def find_bin(name, extra=()):
    w = shutil.which(name)
    if w and "/T/" not in w:
        return w
    for c in extra:
        c = os.path.expanduser(c)
        if os.path.exists(c):
            return c
    return w


_CMUX_SHIM_RE = re.compile(r"/cmux(?:[-./]|$)")


def find_claude():
    """Prefer a stable install over session shims (cmux temp dirs).

    Rejects macOS's system tempdir ("/T/") and paths where "cmux" is its
    own path segment (".../cmux/bin/claude", ".../cmux-workspace-1/..."),
    not merely a substring of an unrelated directory name -- a repo
    checkout named e.g. "quicktasks-cmux-1m" must not trip this.
    """
    w = shutil.which("claude")
    if w and "/T/" not in w and not _CMUX_SHIM_RE.search(w):
        return w
    for c in (
        os.path.expanduser("~/.local/bin/claude"),
        "/opt/homebrew/bin/claude",
        "/usr/local/bin/claude",
        os.path.expanduser("~/.claude/local/claude"),
    ):
        if os.path.exists(c):
            return c
    return w  # last resort: the shim, or None


def find_cmux():
    return find_bin("cmux", ["/Applications/cmux.app/Contents/Resources/bin/cmux"])


def find_notifier():
    """terminal-notifier is opt-in ("notifier": "terminal-notifier" in
    config): on modern macOS its notifications are silently dropped unless
    the user has authorized the app, so the reliable osascript path is the
    default and terminal-notifier is for users who have set it up."""
    if load_config().get("notifier") != "terminal-notifier":
        return None
    return find_bin("terminal-notifier", ["/opt/homebrew/bin/terminal-notifier",
                                          "/usr/local/bin/terminal-notifier"])


def detect_terminals():
    found = []
    if find_cmux():
        found.append("cmux")
    if os.path.isdir("/Applications/Ghostty.app"):
        found.append("Ghostty")
    if os.path.isdir("/Applications/iTerm.app"):
        found.append("iTerm")
    found.append("Terminal")
    return found


# --- notifications ------------------------------------------------------

def notify(title, subtitle, body, execute=None):
    """App-style via terminal-notifier when present; osascript fallback.
    `execute` = shell string run when the notification is clicked."""
    try:
        tn = find_notifier()
        if tn:
            cmd = [tn, "-title", title, "-subtitle", subtitle[:60],
                   "-message", body[:240], "-group", "qt-" + subtitle[:20]]
            if execute:
                cmd += ["-execute", execute]
            subprocess.run(cmd, capture_output=True, timeout=10)
            return
        script = "display notification {} with title {} subtitle {}".format(
            json.dumps(body[:200]), json.dumps(title), json.dumps(subtitle[:60])
        )
        subprocess.run(["osascript", "-e", script], capture_output=True, timeout=10)
    except Exception:
        pass  # notification failure must never fail the task


def write_command_file(name, argv):
    """A .command file that execs `argv` via zsh; used by terminal launchers
    that need an openable script rather than a raw argv (Terminal/Ghostty/
    custom templates all take a path, not a command line)."""
    cmd_file = os.path.join(TMP_DIR, f"{name}.command")
    os.makedirs(TMP_DIR, exist_ok=True)
    with open(cmd_file, "w") as f:
        f.write("#!/bin/zsh\nexec {}\n".format(shlex.join(argv)))
    os.chmod(cmd_file, 0o755)
    return cmd_file


def _run_logged(argv, timeout=15, env=None):
    """Run argv and return (ok, rc, stderr) rather than swallowing the
    outcome: a caller building a resume.log record or a specific fallback
    reason needs the rc and stderr, not just a boolean."""
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, env=env)
        return r.returncode == 0, r.returncode, (r.stderr or "").strip()
    except subprocess.TimeoutExpired:
        return False, None, f"timed out after {timeout}s"
    except (FileNotFoundError, OSError) as e:
        return False, None, str(e)


def _cmux_env():
    """Env for any subprocess that talks to the cmux CLI or app: CMUX_QUIET
    suppresses its deprecation/alias notices, which would otherwise print
    (and get mistaken for a real failure) on every check."""
    return dict(os.environ, CMUX_QUIET="1")


def _cmux_socket_state(cmux):
    """("ok" | "denied" | "down", stderr) for the cmux socket right now,
    probed with `workspace list`. "denied" means cmux is up but its socket
    control mode (default "cmuxOnly") refuses this process for lacking cmux
    ancestry -- a state a bare up/down check reads as "down", which is how
    doctor and setup used to print a green "app not running" line from any
    non-cmux terminal, and how a cold-start resume click sat out the full
    readiness poll against a socket that was answering all along."""
    try:
        r = subprocess.run([cmux, "workspace", "list"], capture_output=True, text=True,
                           timeout=3, env=_cmux_env())
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError) as e:
        return "down", str(e)
    if r.returncode == 0:
        return "ok", ""
    stderr = (r.stderr or "").strip()
    return ("denied" if _is_cmux_access_denied(stderr) else "down"), stderr


def _cmux_ready(cmux):
    """Whether the cmux socket is up and accepting this process right now."""
    return _cmux_socket_state(cmux)[0] == "ok"


def _is_cmux_access_denied(stderr):
    """Whether stderr indicates cmux's socket refused a process with no
    cmux ancestry (default "cmuxOnly" socketControlMode) -- as opposed to
    the socket simply being down. Case-insensitive; covers the wordings
    cmux's CLI has used for this across versions."""
    s = (stderr or "").lower()
    return ("access denied" in s or "only processes started inside cmux" in s
            # cmux 0.63.x closed the connection before the CLI's write had
            # finished, so the same refusal surfaced as a broken pipe (cmux
            # issue #3089). A socket that is down fails to connect instead.
            or ("broken pipe" in s and "socket" in s))


# The one remedy for a cmuxOnly refusal, worded once so the launch
# notification, `qt doctor` and `qt setup` cannot drift apart.
CMUXONLY_REMEDY = ("set cmux Settings > Automation > Socket control to password "
                   "(automation.socketControlMode + socketPassword in "
                   "~/.config/cmux/cmux.json), then cmux reload-config")
CMUXONLY_REASON = ("cmux refused an outside process (socket control mode is cmuxOnly); "
                   + CMUXONLY_REMEDY)
CMUXONLY_SYMPTOM = ("socket refuses processes started outside cmux; resume links "
                    "(Slack, The Pass, menubar) will fall back to Terminal.app")


def _safe_unlink(path):
    try:
        os.unlink(path)
    except OSError:
        pass


def _cmux_outside_probe(cmux, timeout=8):
    """Whether the cmux socket accepts a connection from a process with no
    cmux ancestry and no controlling TTY -- exactly the shape of
    QuicktaskResume.app's launchd-spawned handler, which `doctor` itself
    cannot reproduce by simply shelling out (a `qt doctor` run inside a
    cmux terminal already has cmux ancestry, so it would never see a
    denial). Double-forks and lets the middle process exit immediately so
    the grandchild reparents to launchd (ppid 1) before it calls
    `cmux ping`, then hands the result back through a temp file since the
    grandchild's exit status never reaches this process directly.

    Returns (outcome, detail):
      "ok"          - ping succeeded; outside access works.
      "denied"      - ping failed with cmux's "access denied" message.
      "down"        - ping failed for any other reason, or timed out.
      "unavailable" - the probe itself could not run (fork failed, etc).

    Never raises and never blocks past `timeout` plus a small grace
    period for the fork/wait bookkeeping around it.
    """
    try:
        fd, result_path = tempfile.mkstemp(prefix="qt-cmux-probe-")
        os.close(fd)
    except OSError as e:
        return "unavailable", f"could not create probe result file: {e}"

    # Strip anything cmux-related from the ambient environment (so a stale
    # CMUX_SOCKET_PASSWORD or similar can't leak in) but otherwise inherit
    # it, since the fake-cmux test harness passes its own control vars
    # (FAKE_CMUX_PING_RC, ...) this way too. PATH keeps its inherited entries
    # (a test's fake binary, a pyenv or uv python3 for its shebang) with the
    # cmux binary's own directory in front and the usual system dirs after.
    env = {k: v for k, v in os.environ.items() if not k.startswith("CMUX_")}
    inherited = [p for p in os.environ.get("PATH", "").split(os.pathsep) if p]
    env["PATH"] = os.pathsep.join(
        [os.path.dirname(cmux) or "."] + inherited
        + ["/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin"]
    )
    env["CMUX_QUIET"] = "1"

    sys.stdout.flush()
    sys.stderr.flush()
    try:
        pid = os.fork()
    except OSError as e:
        _safe_unlink(result_path)
        return "unavailable", f"fork failed: {e}"

    if pid == 0:
        # Middle process: start a new session, fork the real prober, then
        # exit right away without waiting -- the prober is orphaned and
        # re-parented to launchd, matching a launchd-spawned handler with
        # no TTY. Every branch below ends in os._exit(); nothing here may
        # return or raise back into whatever process forked us.
        try:
            os.setsid()
        except OSError:
            pass
        try:
            pid2 = os.fork()
        except OSError:
            os._exit(0)
        if pid2 == 0:
            try:
                # cmuxOnly is a PID-ancestry walk, so ping must not run
                # until launchd has adopted this process: a fixed sleep
                # raced the middle process's exit on a loaded machine and
                # could hand back a false "ok".
                deadline = time.monotonic() + 2.0
                while os.getppid() != 1 and time.monotonic() < deadline:
                    time.sleep(0.02)
                try:
                    r = subprocess.run(
                        [cmux, "ping"], capture_output=True, text=True,
                        stdin=subprocess.DEVNULL, timeout=timeout, env=env,
                    )
                    data = {"rc": r.returncode, "stderr": (r.stderr or "")[:500]}
                except subprocess.TimeoutExpired:
                    data = {"rc": None, "stderr": "outside probe: cmux ping timed out"}
                except Exception as e:
                    data = {"rc": None, "stderr": str(e)[:500]}
                try:
                    tmp = result_path + ".tmp"
                    with open(tmp, "w") as f:
                        json.dump(data, f)
                    os.replace(tmp, result_path)
                except OSError:
                    pass
            except Exception:
                pass
            os._exit(0)
        os._exit(0)

    # Parent: reap the middle process (it exits almost immediately), then
    # poll the result file the grandchild writes.
    try:
        os.waitpid(pid, 0)
    except OSError:
        pass

    deadline = time.monotonic() + timeout + 2
    data = None
    while time.monotonic() < deadline:
        try:
            with open(result_path) as f:
                text = f.read().strip()
            if text:
                data = json.loads(text)
                break
        except (OSError, ValueError):
            pass
        time.sleep(0.05)

    _safe_unlink(result_path)

    if data is None:
        return "down", "outside probe timed out waiting for a result"

    rc = data.get("rc")
    stderr = data.get("stderr") or ""
    if rc == 0:
        return "ok", ""
    if _is_cmux_access_denied(stderr):
        return "denied", stderr
    return "down", stderr or f"cmux ping failed (rc {rc})"


def _log_launch(record):
    """Append one JSON line to resume.log, rotating (keep-last) at
    RESUME_LOG_MAX_LINES. A logging failure must never break a launch."""
    try:
        os.makedirs(LOGS_DIR, exist_ok=True)
        lines = []
        if os.path.exists(RESUME_LOG):
            with open(RESUME_LOG) as f:
                lines = f.readlines()
        lines.append(json.dumps(record) + "\n")
        if len(lines) > RESUME_LOG_MAX_LINES:
            lines = lines[-RESUME_LOG_MAX_LINES:]
        tmp = RESUME_LOG + ".tmp"
        with open(tmp, "w") as f:
            f.writelines(lines)
        os.replace(tmp, RESUME_LOG)
    except Exception:
        pass


def _launch_cmux(workspace_name, argv):
    """Try cmux new-workspace with argv as the command. If the socket is
    down (app not running), launch the app and poll for it before retrying
    once. Returns (ok, reason, attempts): ok is True only if a new-workspace
    call actually succeeded; reason is one of a small set of specific
    causes ("cmux CLI not found", "cmux refused an outside process (socket
    control mode is cmuxOnly); set cmux Settings > Automation > Socket
    control to password", "cmux socket not answering after 10 s", or
    "cmux new-workspace failed (rc N): <stderr head>") so a fallback
    notification never has to say the generic "cmux unreachable"; attempts
    is every subprocess call actually made, each as
    {"argv": [...first 3 tokens...], "rc": int|None, "stderr": str}.

    An "access denied" failure is a distinct case from the socket being
    down: it means cmux is up and answering, but its socket control mode
    (default "cmuxOnly") refuses any process without cmux ancestry -- the
    exact shape of a launchd-spawned resume click. Retrying via `open -ga
    cmux` or polling for readiness would only get denied again, so that
    case returns immediately instead of burning the usual ~10s wait."""
    attempts = []
    cmux = find_cmux()
    if not cmux:
        return False, "cmux CLI not found", attempts

    new_workspace = [cmux, "new-workspace", "--name", workspace_name,
                      "--command", shlex.join(argv), "--focus", "true"]
    env = _cmux_env()

    ok, rc, stderr = _run_logged(new_workspace, env=env)
    attempts.append({"argv": new_workspace[:3], "rc": rc, "stderr": stderr[:200]})
    if ok:
        return True, None, attempts

    if _is_cmux_access_denied(stderr):
        return False, CMUXONLY_REASON, attempts

    _, open_rc, open_stderr = _run_logged(["open", "-ga", "cmux"], env=env)
    attempts.append({"argv": ["open", "-ga", "cmux"], "rc": open_rc, "stderr": open_stderr[:200]})

    # Cold start: the app was down for the first attempt, so a refusal can
    # only show once it is up. Poll the socket's state rather than a bare
    # up/down bool, so a cmuxOnly refusal ends the wait at once instead of
    # masquerading as "not answering" for the full 10 s.
    deadline = time.monotonic() + 10
    became_ready = False
    while time.monotonic() < deadline:
        state, probe_stderr = _cmux_socket_state(cmux)
        if state == "ok":
            became_ready = True
            break
        if state == "denied":
            attempts.append({"argv": [cmux, "workspace", "list"], "rc": 1,
                             "stderr": probe_stderr[:200]})
            return False, CMUXONLY_REASON, attempts
        time.sleep(0.5)

    if not became_ready:
        return False, "cmux socket not answering after 10 s", attempts

    ok, rc, stderr = _run_logged(new_workspace, env=env)
    attempts.append({"argv": new_workspace[:3], "rc": rc, "stderr": stderr[:200]})
    if ok:
        return True, None, attempts
    if _is_cmux_access_denied(stderr):
        return False, CMUXONLY_REASON, attempts

    return False, f"cmux new-workspace failed (rc {rc}): {stderr[:200]}", attempts


def _cmux_outside_access(cmux):
    """One verdict on whether a process without cmux ancestry can reach the
    cmux socket, as (verdict, detail): "ok", "denied", "down" (app not
    running) or "inconclusive" (the detached probe itself failed). This
    process's own view comes first: a doctor or setup run from Terminal.app
    is already an outside process, so a refusal there is the answer and the
    detached probe is only paid for when this process was let in."""
    state, detail = _cmux_socket_state(cmux)
    if state != "ok":
        return state, detail
    outcome, detail = _cmux_outside_probe(cmux)
    if outcome in ("ok", "denied"):
        return outcome, detail
    return "inconclusive", f"{outcome}: {detail}"


def _launch_in_terminal(file_stub, workspace_name, argv):
    """Launch `argv` in the user's preferred terminal (config "terminal"),
    following the cmux -> Ghostty -> custom template -> Terminal.app chain.
    Any fallback away from the configured terminal raises a notification
    naming the real reason instead of failing silently, and an unexpected
    exception still ends in a Terminal attempt rather than a stack trace:
    this path runs from notification clicks and Raycast, where stderr is
    invisible. Every call appends exactly one JSON record to resume.log
    (see _log_launch), whose "outcome" is one of "cmux", "ghostty",
    "custom" (all launched-as-requested), "terminal-forced" (Terminal was
    the requested terminal, or the request used something unrecognized
    that goes straight to `open -a <term>`, no fallback involved), or
    "terminal-fallback" (a non-Terminal choice failed and Terminal.app was
    used instead)."""
    start = time.monotonic()
    requested = load_config().get("terminal", "Terminal")
    term = requested
    branch = requested
    attempts = []
    rc = None
    stderr = ""
    fell_back = False

    def log(outcome):
        _log_launch({
            "ts": now(),
            "requested_terminal": requested,
            "branch": branch,
            "attempts": attempts,
            "rc": rc,
            "stderr": (stderr or "")[:200],
            "elapsed": round(time.monotonic() - start, 3),
            "outcome": outcome,
        })

    try:
        if term == "cmux":
            branch = "cmux"
            ok, reason, cmux_attempts = _launch_cmux(workspace_name, argv)
            attempts.extend(cmux_attempts)
            if ok:
                log("cmux")
                return
            last = cmux_attempts[-1] if cmux_attempts else {}
            rc, stderr = last.get("rc"), last.get("stderr", "")
            notify("Quicktask resume", workspace_name, f"{reason} · qt doctor")
            term = "Terminal"
            fell_back = True

        script = write_command_file(file_stub, argv)

        if term == "Ghostty":
            branch = "ghostty"
            ghostty_argv = ["open", "-na", "Ghostty", "--args", "-e", script]
            ok, g_rc, g_stderr = _run_logged(ghostty_argv)
            attempts.append({"argv": ghostty_argv[:3], "rc": g_rc, "stderr": g_stderr[:200]})
            if ok:
                log("ghostty")
                return
            rc, stderr = g_rc, g_stderr
            notify("Quicktask resume", workspace_name,
                   "Ghostty unreachable, opened in Terminal instead · qt doctor")
            term = "Terminal"
            fell_back = True

        if "{script}" in term:  # custom command template, tokenized (no shell)
            branch = "custom"
            custom_argv = [a.replace("{script}", script) for a in shlex.split(term)]
            ok, c_rc, c_stderr = _run_logged(custom_argv)
            attempts.append({"argv": custom_argv[:3], "rc": c_rc, "stderr": c_stderr[:200]})
            if ok:
                log("custom")
                return
            rc, stderr = c_rc, c_stderr
            notify("Quicktask resume", workspace_name,
                   "custom terminal command failed, opened in Terminal instead · qt doctor")
            term = "Terminal"
            fell_back = True

        term_argv = ["open", "-a", term, script]
        ok, t_rc, t_stderr = _run_logged(term_argv)
        attempts.append({"argv": term_argv[:3], "rc": t_rc, "stderr": t_stderr[:200]})
        if not fell_back:
            branch = "terminal"
            log("terminal-forced")
        else:
            if rc is None and not stderr:
                rc, stderr = t_rc, t_stderr
            log("terminal-fallback")
    except Exception as e:
        try:
            script = write_command_file(file_stub, argv)
            subprocess.run(["open", "-a", "Terminal", script], capture_output=True, timeout=15)
        except Exception:
            pass
        notify("Quicktask resume", workspace_name,
               "terminal launch failed, opened in Terminal instead · qt doctor")
        attempts.append({"argv": ["open", "-a", "Terminal"], "rc": None, "stderr": str(e)[:200]})
        rc, stderr = None, str(e)
        log("terminal-fallback")


def launch_resume_terminal(tid):
    """Open the user's preferred terminal running `qt resume <tid>`."""
    argv = [sys.executable, os.path.abspath(__file__), "resume", tid]
    _launch_in_terminal(f"resume-{tid}", f"qt {tid}", argv)


def launch_test_terminal():
    """Open the user's preferred terminal running a harmless self-test
    command. Used by `qt setup`'s "test launch now?" prompt; never resumes
    a real session."""
    argv = [sys.executable, os.path.abspath(__file__), "_test-echo"]
    _launch_in_terminal("test-launch", "qt test launch", argv)


def notify_blocked(task, denials):
    names = ", ".join(sorted({d.get("tool_name", "?") for d in denials})) or "a tool call"
    if find_notifier():
        qt_bin = os.path.abspath(__file__)
        execute = "{} {} _resume-launch {}".format(
            shlex.quote(sys.executable), shlex.quote(qt_bin), shlex.quote(task["id"])
        )
        term = load_config().get("terminal", "Terminal")
        notify(
            "Quicktask ⊘ blocked",
            task["prompt"],
            f"Denied: {names} · click to resume in {term}",
            execute=execute,
        )
    else:
        notify(
            "Quicktask ⊘ blocked",
            task["prompt"],
            f"Denied: {names} · resume via Raycast 'Quick Task Resume' or qt resume {task['id']}",
        )


# --- plumbing -----------------------------------------------------------

def bootstrap():
    for d in (TASKS_DIR, LOGS_DIR, WORKSPACE, TMP_DIR):
        os.makedirs(d, exist_ok=True)
    claude_md = os.path.join(WORKSPACE, "CLAUDE.md")
    if not os.path.exists(claude_md):
        with open(claude_md, "w") as f:
            f.write(WORKSPACE_CLAUDE_MD)


def task_path(tid):
    return os.path.join(TASKS_DIR, tid + ".json")


def load(tid):
    with open(task_path(tid)) as f:
        return json.load(f)


def save(task):
    tmp = task_path(task["id"]) + ".tmp"
    with open(tmp, "w") as f:
        json.dump(task, f, indent=2)
    os.replace(tmp, task_path(task["id"]))


def now():
    return datetime.datetime.now().isoformat(timespec="seconds")


def new_id(prompt):
    stamp = datetime.datetime.now().strftime("%y%m%d-%H%M%S")
    words = re.sub(r"[^a-z0-9 ]", "", prompt.lower()).split()[:3]
    slug = "-".join(words)[:24].strip("-")
    base = f"{stamp}-{slug}" if slug else stamp
    tid = base
    n = 1
    while os.path.exists(task_path(tid)):
        n += 1
        tid = f"{base}-{n}"
    return tid


# --- queue / run --------------------------------------------------------

def queue(prompt, wait=False, in_dir=None, model=None):
    bootstrap()
    invoked = os.getcwd()
    if in_dir:
        run_cwd = os.path.realpath(os.path.expanduser(in_dir))
        if not os.path.isdir(run_cwd):
            sys.exit(f"--in: not a directory: {run_cwd}")
    elif is_trusted(invoked):
        run_cwd = invoked
    else:
        run_cwd = WORKSPACE
    trusted = is_trusted(run_cwd)
    perm_mode = resolve_trusted_permissions() if trusted else resolve_permissions()

    tid = new_id(prompt)
    task = {
        "id": tid,
        "prompt": prompt,
        "status": "queued",
        "created": now(),
        "origin": ORIGIN_ENV if ORIGIN_ENV in QT_ORIGINS else "qt",
        "invoked_from": invoked,
        "run_cwd": run_cwd,
        "perm_mode": perm_mode,
        "model": model or MODEL or load_config().get("model") or None,
        "session_id": None,
        "result": None,
        "cost_usd": None,
    }
    save(task)
    if wait:
        run_task(tid, interactive=True)
        t = load(tid)
        print(f"[{t['status']}] {t.get('result') or ''}")
        if t["status"] == "blocked":
            print(f"\ndenied: {', '.join(d.get('tool_name', '?') for d in t.get('denials', []))}")
            print(f"qt resume {tid}  # approve and continue")
        sys.exit(0 if t["status"] == "done" else 1)
    log = open(os.path.join(LOGS_DIR, tid + ".log"), "a")
    subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "_run", tid],
        stdout=log, stderr=log, start_new_session=True, cwd=QT_DATA,
    )
    trust_note = f" (trusted dir, {perm_mode})" if trusted else ""
    print(f"queued {tid}{trust_note}")


def task_prompt(task):
    """Compose the prompt for the claude run: the task text, the fired-from
    context, and a per-task Slack resume footer (the id only exists per
    task, so the prompt carries it rather than the workspace CLAUDE.md)."""
    tid = task["id"]
    return task["prompt"] + (
        f"\n\n(Context: task fired from directory {task['invoked_from']}. "
        "Only relevant if the task references the current directory or repo.)"
        f"\n\n(Your quicktask id is {tid}. If you post any Slack message as part "
        "of this task, end that message with this exact final line:\n"
        f"↩ resume: `qt resume {tid}` · <quicktask://resume/{tid}|open in terminal>\n"
        "Slack messages only; do not add this line to your final result text.)"
    )


# --- hub feed -------------------------------------------------------------
# Stage 1 of hub mode: mirror finished tasks into The Pass's ledger so they
# surface in its Verify queue. Off unless hub_dir/QT_HUB is set; see
# resolve_hub_dir() above and _feed_hub() below.

def _hub_title(prompt):
    t = prompt.replace("\n", " ").strip()
    return t[:59] + "…" if len(t) > 60 else t


def _hub_item(task):
    return {
        "id": f"qt-{task['id']}",
        "title": _hub_title(task["prompt"]),
        "quote": task["prompt"],
        "source": "qt",
        "state": "today",
        "date": (task.get("created") or now())[:10],
    }


def _seed_hub_item(hub_dir, item):
    """Insert `item` via the hub's own seed.py, which is the idempotent
    merge point: a re-fed id is reported and skipped, never overwritten."""
    seed_script = os.path.join(hub_dir, "seed.py")
    if not os.path.isfile(seed_script):
        raise RuntimeError(f"seed.py not found: {seed_script}")
    os.makedirs(TMP_DIR, exist_ok=True)
    frag_path = os.path.join(TMP_DIR, f"hub-item-{item['id']}.json")
    with open(frag_path, "w") as f:
        json.dump(item, f)
    try:
        subprocess.run(
            [sys.executable, seed_script, frag_path],
            capture_output=True, text=True, timeout=30, check=True,
        )
    finally:
        try:
            os.remove(frag_path)
        except OSError:
            pass


def _hub_job_record(task, item_id, rc):
    """Map a finished qt task onto a hub jobs/<slug>/job.json record, plus
    the RESULT.md body that goes with it. The hub understands done/failed/
    blocked directly; only qt's timeout status has no hub equivalent, so it
    becomes failed with an explanatory error and a resume hint."""
    status = task["status"]
    resume_hint = f"qt resume {task['id']}"
    job = {
        "item_id": item_id,
        "title": _hub_title(task["prompt"]),
        "started": task.get("started") or task.get("created") or now(),
        "finished": task.get("finished") or now(),
        "home_state": "today",
        "session_id": task.get("session_id"),
        # Defaults to "qt" for a task saved before this field existed, same
        # fallback queue() itself applies to an unset/unknown QT_ORIGIN.
        "origin": task.get("origin") or "qt",
    }
    if rc is not None:
        job["rc"] = rc

    if status == "done":
        job["status"] = "done"
        body = task.get("result") or "(no result text)"
    elif status == "timeout":
        job["status"] = "failed"
        job["error"] = "timeout"
        body = f"Timed out.\n\n↩ resume: `{resume_hint}`"
    elif status == "blocked":
        denials = task.get("denials") or []
        names = ", ".join(sorted({d.get("tool_name") or "?" for d in denials})) or "a tool call"
        job["status"] = "blocked"
        job["error"] = f"blocked: {len(denials)} permission denials; resume: {resume_hint}"
        job["denials"] = denials
        body = f"Blocked on {names}.\n\n↩ resume: `{resume_hint}`"
    else:  # "failed": claude missing, nonzero rc, is_error, or anything unexpected
        job["status"] = "failed"
        if task.get("result"):
            job["error"] = task["result"]
        body = task.get("result") or f"Failed.\n\n↩ resume: `{resume_hint}`"
    return job, body


def _write_hub_job(hub_dir, task, rc):
    item_id = f"qt-{task['id']}"
    ts = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%d-%H%M%S")
    jobdir = os.path.join(hub_dir, "jobs", f"{item_id}-{ts}")
    os.makedirs(os.path.join(jobdir, "output"), exist_ok=True)
    job, body = _hub_job_record(task, item_id, rc)
    # RESULT.md lands before job.json claims a terminal status; a reader
    # scanning jobs/ must never see "done" with the result still missing.
    with open(os.path.join(jobdir, "output", "RESULT.md"), "w") as f:
        f.write(body.rstrip() + "\n")
    job_path = os.path.join(jobdir, "job.json")
    tmp = job_path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(job, f, indent=2)
    os.replace(tmp, job_path)
    return jobdir


def _notify_hub_job(hub_dir, jobdir):
    """Ask the hub to post a Slack finish notice for this job via its own
    notice.py, which owns the policy (when to post, how to format) and is
    itself best-effort. A missing notice.py is a silent no-op, same as a
    hub not wired up for it at all -- qt doesn't decide notification
    policy, it just invokes it. No --thread: a qt task has no preceding
    fire message to thread under."""
    notice_script = os.path.join(hub_dir, "notice.py")
    if not os.path.isfile(notice_script):
        return
    # A short timeout: this sits between task completion and the local
    # osascript notify() at the end of the finish path, so a hung notice.py
    # would delay the thing John actually sees first. Slack sends are
    # sub-second; 10s is already generous.
    subprocess.run(
        [sys.executable, notice_script, jobdir],
        capture_output=True, text=True, timeout=10, check=True,
    )


def _deliver_hub_job(hub_dir, jobdir):
    """Hand a finished job to the hub's own deliver.py, which decides
    whether it auto-closes or waits in Verify -- qt never makes that call,
    it just invokes the hub's policy, the same way _notify_hub_job invokes
    notice.py's. A missing deliver.py is a silent no-op, same as a hub not
    wired up for it at all. Runs before the finish notice so notice.py sees
    whatever deliver.py stamped on the job first."""
    deliver_script = os.path.join(hub_dir, "deliver.py")
    if not os.path.isfile(deliver_script):
        return
    # Same 10s ceiling as the notice call below: this too sits ahead of the
    # local osascript notify() at the end of the finish path.
    subprocess.run(
        [sys.executable, deliver_script, jobdir],
        capture_output=True, text=True, timeout=10, check=True,
    )


def _feed_hub(task, rc=None):
    """Mirror a finished task into The Pass's ledger so it surfaces in the
    Verify queue, hand it to the hub's deliver.py, and ask the hub to raise
    a Slack finish notice, when hub_dir is configured. Best-effort: this
    must never break a task, so every failure is caught and logged, never
    raised."""
    hub_dir = resolve_hub_dir()
    if not hub_dir:
        return
    try:
        _seed_hub_item(hub_dir, _hub_item(task))
        jobdir = _write_hub_job(hub_dir, task, rc)
        try:
            # Delivery runs before the notice (see _deliver_hub_job) and is
            # independent of it: a stuck/broken deliver.py should not also
            # swallow the Slack notice this task would otherwise get.
            _deliver_hub_job(hub_dir, jobdir)
        except Exception as e:
            try:
                with open(os.path.join(LOGS_DIR, task["id"] + ".log"), "a") as f:
                    f.write(f"\n--- hub deliver failed: {e} ---\n")
            except OSError:
                pass
        try:
            # By this point the record is already on disk (seed + job.json
            # + RESULT.md); only the Slack notice can still fail, so it
            # gets its own message rather than "hub feed failed" pointing a
            # future debugger at the wrong subsystem.
            _notify_hub_job(hub_dir, jobdir)
        except Exception as e:
            try:
                with open(os.path.join(LOGS_DIR, task["id"] + ".log"), "a") as f:
                    f.write(f"\n--- hub notice failed: {e} ---\n")
            except OSError:
                pass
    except Exception as e:
        try:
            with open(os.path.join(LOGS_DIR, task["id"] + ".log"), "a") as f:
                f.write(f"\n--- hub feed failed: {e} ---\n")
        except OSError:
            pass


def run_task(tid, interactive=False):
    task = load(tid)
    task["status"] = "running"
    task["started"] = now()
    save(task)

    claude = find_claude()
    if not claude:
        task.update(status="failed", result="claude CLI not found on PATH", finished=now())
        save(task)
        _feed_hub(task)
        notify("Quicktask failed", task["prompt"], "claude CLI not found")
        return

    prompt = task_prompt(task)
    cmd = [
        claude, "-p", prompt,
        "--output-format", "json",
        "--permission-mode", task.get("perm_mode") or resolve_permissions(),
    ]
    if task.get("model"):
        cmd += ["--model", task["model"]]

    log_path = os.path.join(LOGS_DIR, tid + ".log")
    run_cwd = task.get("run_cwd", WORKSPACE)
    try:
        proc = subprocess.run(
            cmd, cwd=run_cwd, capture_output=True, text=True, timeout=TIMEOUT
        )
        stdout, stderr, rc = proc.stdout, proc.stderr, proc.returncode
    except subprocess.TimeoutExpired as e:
        stdout = (e.stdout or b"").decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
        with open(log_path, "a") as f:
            f.write(stdout + f"\n--- timed out after {TIMEOUT}s ---\n")
        task.update(status="timeout", result=f"timed out after {TIMEOUT}s", finished=now())
        save(task)
        _feed_hub(task)
        notify("Quicktask timed out", task["prompt"], f"after {TIMEOUT}s · qt log {tid}")
        return

    with open(log_path, "a") as f:
        f.write(stdout)
        if stderr:
            f.write("\n--- stderr ---\n" + stderr)

    data = {}
    for line in reversed(stdout.strip().splitlines()):
        line = line.strip()
        if line.startswith("{"):
            try:
                data = json.loads(line)
                break
            except json.JSONDecodeError:
                continue

    result = (data.get("result") or "").strip()
    denials = data.get("permission_denials") or []
    ok = rc == 0 and not data.get("is_error", False)
    if denials:
        status = "blocked"
    elif ok:
        status = "done"
    else:
        status = "failed"
    task.update(
        status=status,
        result=result or (stderr.strip()[-300:] if not ok else ""),
        session_id=data.get("session_id"),
        cost_usd=data.get("total_cost_usd"),
        denials=[
            {"tool_name": d.get("tool_name"), "tool_input": d.get("tool_input")}
            for d in denials
        ],
        finished=now(),
    )
    save(task)
    _feed_hub(task, rc=rc)

    if status == "blocked":
        if not interactive:
            notify_blocked(task, denials)
        return
    icon = "✓" if status == "done" else "✗"
    cost = f" · ${task['cost_usd']:.2f}" if task.get("cost_usd") else ""
    notify(
        f"Quicktask {icon}{cost}",
        task["prompt"],
        result.splitlines()[0] if result else status,
    )


# --- commands -----------------------------------------------------------

def age(iso):
    delta = datetime.datetime.now() - datetime.datetime.fromisoformat(iso)
    s = int(delta.total_seconds())
    for unit, div in (("d", 86400), ("h", 3600), ("m", 60)):
        if s >= div:
            return f"{s // div}{unit}"
    return f"{s}s"


def cmd_list(n=15):
    bootstrap()
    files = sorted(
        (f for f in os.listdir(TASKS_DIR) if f.endswith(".json")), reverse=True
    )[:n]
    if not files:
        print('no quicktasks yet · qt "do a thing"')
        return
    glyph = {"done": "✓", "failed": "✗", "timeout": "⏱", "running": "…",
             "queued": "·", "blocked": "⊘"}
    for f in files:
        with open(os.path.join(TASKS_DIR, f)) as fh:
            t = json.load(fh)
        p = t["prompt"].replace("\n", " ")[:56]
        r = (t.get("result") or "").replace("\n", " ")[:60]
        print(f"{glyph.get(t['status'], '?')} {age(t['created']):>4} {t['id']:<32} {p:<58} {r}")


def cmd_log(tid):
    t = load(tid)
    print(json.dumps({k: v for k, v in t.items() if k != "result"}, indent=2))
    print("\n--- result ---\n" + (t.get("result") or "(none)"))
    log = os.path.join(LOGS_DIR, tid + ".log")
    if os.path.exists(log):
        print(f"\nraw log: {log}")


def cmd_resume_log(n=10):
    """Print the last n resume.log records, one per line, newest last."""
    try:
        n = int(n)
    except (TypeError, ValueError):
        n = 10
    if not os.path.exists(RESUME_LOG):
        print(f"no resume launches logged yet ({RESUME_LOG} doesn't exist)")
        return
    with open(RESUME_LOG) as f:
        lines = [ln.strip() for ln in f if ln.strip()]
    for ln in lines[-n:]:
        try:
            rec = json.loads(ln)
        except ValueError:
            print(ln)
            continue
        if rec.get("outcome") == "no-task":
            print(f"{rec.get('ts', '?')}  no-task fragment={rec.get('fragment', '?')}")
            if rec.get("candidates"):
                print(f"    candidates tried: {', '.join(rec['candidates'])}")
            continue
        print(f"{rec.get('ts', '?')}  {rec.get('outcome', '?'):<18} "
              f"requested={rec.get('requested_terminal', '?')} branch={rec.get('branch', '?')} "
              f"rc={rec.get('rc')} elapsed={rec.get('elapsed')}s")
        if rec.get("stderr"):
            print(f"    stderr: {rec['stderr']}")


def cmd_resume(tid):
    t = load(tid)
    sid = t.get("session_id")
    if not sid:
        sys.exit(f"no session id recorded for {tid} (status: {t['status']})")
    os.chdir(t.get("run_cwd", WORKSPACE))
    claude = find_claude()
    if not claude:
        sys.exit("claude CLI not found on PATH")
    os.execvp(claude, [claude, "--resume", sid])


def cmd_trust(path=None):
    cfg = load_config()
    dirs = cfg.get("trusted_dirs", [])
    if path is None:
        if dirs:
            for d in dirs:
                print(d)
        else:
            print("no trusted dirs · qt trust <dir> to add one (tasks run in place there)")
        return
    p = os.path.realpath(os.path.expanduser(path))
    if not os.path.isdir(p):
        sys.exit(f"not a directory: {p}")
    if p in [os.path.realpath(os.path.expanduser(d)) for d in dirs]:
        print(f"already trusted: {p}")
        return
    dirs.append(p)
    cfg["trusted_dirs"] = dirs
    save_config(cfg)
    print(f"trusted: {p}\ntasks fired here now run in place ({resolve_trusted_permissions()} permissions)")


def cmd_untrust(path):
    cfg = load_config()
    p = os.path.realpath(os.path.expanduser(path))
    dirs = [d for d in cfg.get("trusted_dirs", [])
            if os.path.realpath(os.path.expanduser(d)) != p]
    if len(dirs) == len(cfg.get("trusted_dirs", [])):
        sys.exit(f"was not trusted: {p}")
    cfg["trusted_dirs"] = dirs
    save_config(cfg)
    print(f"untrusted: {p}")


def cmd_hub(arg=None):
    cfg = load_config()
    if arg is None or arg == "status":
        d = resolve_hub_dir()
        if HUB_DIR_ENV:
            print(f"{d} (from QT_HUB)")
        elif d:
            print(d)
        else:
            print("off · qt hub <dir> to feed finished tasks into a Pass ledger")
        return
    if arg == "off":
        cfg.pop("hub_dir", None)
        save_config(cfg)
        print("hub feed off")
        return
    p = os.path.realpath(os.path.expanduser(arg))
    if not os.path.isdir(p):
        sys.exit(f"not a directory: {p}")
    if not os.path.isfile(os.path.join(p, "seed.py")):
        sys.exit(f"not a hub dir (no seed.py): {p}")
    cfg["hub_dir"] = p
    save_config(cfg)
    print(f"hub feed on: {p}\nfinished tasks now land in its Verify queue")


def cmd_setup():
    bootstrap()
    cfg = load_config()
    candidates = detect_terminals()
    cur = cfg.get("terminal", candidates[0])

    print("Preferred terminal (blocked tasks resume there):")
    for i, c in enumerate(candidates, 1):
        mark = "  ← current" if c == cur else ""
        print(f"  {i}. {c}{mark}")
    print("  or paste a custom command template containing {script}")
    choice = input(f"choice [{cur}]: ").strip()
    if choice.isdigit() and 1 <= int(choice) <= len(candidates):
        cfg["terminal"] = candidates[int(choice) - 1]
    elif choice in candidates or "{script}" in choice:
        cfg["terminal"] = choice
    elif choice:
        print(f"  unrecognized, keeping {cur}")
        cfg["terminal"] = cur
    else:
        cfg["terminal"] = cur
    save_config(cfg)  # so a test launch below picks up the chosen terminal

    if cfg["terminal"] == "cmux":
        cmux = find_cmux()
        if cmux and _cmux_outside_access(cmux)[0] == "denied":
            print(f"\n!  cmux's {CMUXONLY_SYMPTOM}.")
            print(f"   Fix: {CMUXONLY_REMEDY}.")

    if input("test launch now? [y/N]: ").strip().lower() in ("y", "yes"):
        print('  opening... look for "qt: terminal launch works. You can close this."')
        launch_test_terminal()

    dirs = cfg.get("trusted_dirs", [])
    print('\nTrusted dirs: tasks there run in the dir itself with "auto" permissions')
    print("(a model approves safe tool calls, denies risky ones); everywhere else")
    print('runs in the sandbox workspace and may come back "blocked" for approval.')
    if os.path.isdir(os.path.expanduser("~/code")) and os.path.expanduser("~/code") not in dirs:
        print("  example candidate: ~/code")
    print(f"  current: {', '.join(dirs) or 'none'}")
    add = input("add dirs (space-separated, ~ ok, empty to skip): ").strip()
    if add:
        for d in shlex.split(add):
            p = os.path.realpath(os.path.expanduser(d))
            if not os.path.isdir(p):
                print(f"  skipped (not a dir): {p}")
            elif p in dirs:
                print(f"  already trusted: {p}")
            else:
                dirs.append(p)
                print(f"  trusted: {p}")
        cfg["trusted_dirs"] = dirs

    cur_perm = cfg.get("permissions", "acceptEdits")
    print(f"\nPermissions for everything outside a trusted dir (current: {cur_perm}):")
    print("  1. keep current")
    print("  2. acceptEdits · headless denies anything outside your allowlist")
    print("  3. auto · a classifier approves safe calls and denies risky ones,")
