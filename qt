_HUB_SLUG_TS_RE = re.compile(r"-\d{8}-\d{6}$")


def _hub_slug_candidates(fragment):
    """Derive candidate original task ids from a hub job slug. The Pass
    names a qt-originated run's job directory
    qt-<task id>-<YYYYMMDD>-<HHMMSS> (e.g.
    qt-260909-165637-do-a-deep-20260909-210126), while qt's own task
    record is 260909-165637-do-a-deep -- so a leading "qt-" and/or a
    trailing "-YYYYMMDD-HHMMSS" get stripped, in every combination that
    applies, most specific (both stripped) first. Never includes
    `fragment` itself; a plain id with neither yields nothing."""
    has_prefix = fragment.startswith("qt-")
    ts_match = _HUB_SLUG_TS_RE.search(fragment)

    candidates = []
    if has_prefix and ts_match:
        candidates.append(fragment[len("qt-"):ts_match.start()])
    if has_prefix:
        candidates.append(fragment[len("qt-"):])
    if ts_match:
        candidates.append(fragment[:ts_match.start()])

    seen = set()
    result = []
    for c in candidates:
        if c and c != fragment and c not in seen:
            seen.add(c)
            result.append(c)
    return result


def _exact_or_unique_substring(fragment, names):
    """An exact id always wins, so a task's own published link resolves
    even when another id contains it as a substring. Returns the resolved
    id, or None if `fragment` matched nothing in `names` (letting a caller
    try another candidate). Ambiguity still exits immediately, unchanged
    from match_id's original behavior."""
    if fragment in names:
        return fragment
    hits = [n for n in names if fragment in n]
    if len(hits) == 1:
        return hits[0]
    if not hits:
        return None
    sys.exit(f"ambiguous: {', '.join(sorted(hits))}")


def _resolve_id_or_none(fragment):
    """Like match_id, but returns None instead of exiting when nothing
    matches at all -- letting a caller (namely _resume-launch) handle
    "not found" itself instead of getting a raised SystemExit. Ambiguity
    still exits immediately and unchanged: it is a different, specific
    failure from "no match anywhere", not one a caller should paper over.
    An exact id always wins, so a task's own published link resolves even
    when another id contains it as a substring. When the raw fragment
    matches nothing, a hub job slug (qt-<task id>-<timestamp>) is retried
    via its derived candidates -- see _hub_slug_candidates -- so a
    `quicktask://resume/` link built from a hub job dir name still
    resolves to the original task."""
    names = [f[:-5] for f in os.listdir(TASKS_DIR) if f.endswith(".json")]
    result = _exact_or_unique_substring(fragment, names)
    if result is not None:
        return result
    for candidate in _hub_slug_candidates(fragment):
        result = _exact_or_unique_substring(candidate, names)
        if result is not None:
            return result
    return None


def match_id(fragment):
    """Allow qt log/resume with a unique id fragment. See
    _resolve_id_or_none for the resolution rules; this just exits when it
    comes back empty."""
    tid = _resolve_id_or_none(fragment)
    if tid is None:
        sys.exit(f"no task matching '{fragment}'")
    return tid


HELP = """\
qt · fire-and-forget quicktasks for Claude Code

  qt "do a thing"        queue a task, return immediately, notify on finish
  qt -w "do a thing"     run in the foreground and print the result
  qt --in <dir> "..."    run the task in <dir> (in place if trusted)
  qt -m <model> "..."    override the model for this task
  qt list [n]            recent tasks (default 15)
  qt log <id>            full record + raw log path (id fragments ok)
  qt resume-log [n]      last n resume-launch records (default 10)
  qt resume <id>         reopen a task as an interactive session
  qt setup               pick terminal, trusted dirs, permission mode
  qt doctor              read-only environment health check
  qt install-handler     register quicktask:// links (clickable Slack resume)
  qt uninstall-handler   remove the quicktask:// handler and registration
  qt trust [dir]         list trusted dirs, or add one (tasks run in place)
  qt untrust <dir>       remove a trusted dir
  qt hub <dir>|off|status   feed finished tasks into a Pass ledger, or check

Runs fired from inside a trusted dir run there with "auto" permissions
(config "trusted_permissions" overrides, e.g. "bypassPermissions").
Everything else runs conservatively; a denied tool call marks the task
"blocked" (⊘) and raises a notification. Resume it via the Raycast
"Quick Task Resume" command (opens your preferred terminal on that
session) or qt resume <id>.

When hub_dir is set, every finished task is also seeded into that Pass
checkout's ledger and given a jobs/ record, so it shows up in its Verify
queue. Off by default; zero effect on anything until you set it.

config (env): QT_DATA (~/.quicktasks) · QT_TIMEOUT (1800s) · QT_MODEL
(inherit) · QT_PERMISSIONS (acceptEdits by default) · QT_HUB (unset = off)
"""


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("help", "-h", "--help"):
        print(HELP)
        return
    cmd = args[0]
    if cmd == "list":
        try:
            n = int(args[1]) if len(args) > 1 else 15
        except ValueError:
            sys.exit(f"usage: qt list [count], got '{args[1]}'")
        cmd_list(n)
    elif cmd == "log" and len(args) > 1:
        bootstrap()
        cmd_log(match_id(args[1]))
    elif cmd == "resume-log":
        cmd_resume_log(args[1] if len(args) > 1 else 10)
    elif cmd == "resume" and len(args) > 1:
        bootstrap()
        cmd_resume(match_id(args[1]))
    elif cmd == "setup":
        cmd_setup()
    elif cmd == "doctor":
        cmd_doctor()
    elif cmd == "install-handler":
        cmd_install_handler()
    elif cmd == "uninstall-handler":
        cmd_uninstall_handler()
    elif cmd == "trust":
        cmd_trust(args[1] if len(args) > 1 else None)
    elif cmd == "untrust" and len(args) > 1:
        cmd_untrust(args[1])
    elif cmd == "hub":
        cmd_hub(args[1] if len(args) > 1 else None)
    elif cmd == "_run" and len(args) > 1:
        run_task(args[1])
    elif cmd == "_resume-launch":
        bootstrap()
        if len(args) > 1:
            fragment = args[1]
            tid = _resolve_id_or_none(fragment)
            if tid is None:
                # Nothing matched, including every hub-slug candidate: the
                # link sent an id that doesn't exist rather than hitting a
                # real launch failure, so record it and tell the user
                # instead of exiting silently under a missed notification.
                candidates = _hub_slug_candidates(fragment)
                _log_launch({
                    "ts": now(),
                    "outcome": "no-task",
                    "fragment": fragment,
                    "candidates": candidates,
                })
                msg = f"no quicktask matching {fragment} · qt resume-log"
                notify("Quicktask resume", "no match", msg)
                sys.exit(msg)
            launch_resume_terminal(tid)
        else:
            launch_resume_terminal(latest_blocked())
    elif cmd == "_test-echo":
        cmd_test_echo()
    elif cmd in ("log", "resume", "untrust"):
        # without this arm a bare `qt resume` would fall through to the
        # catch-all and queue a paid task with "resume" as the prompt
        sys.exit(f"usage: qt {cmd} <id>")
    else:
        wait = False
        in_dir = None
        model = None
        while args and args[0] in ("-w", "--wait", "--in", "-m", "--model"):
            if args[0] in ("-w", "--wait"):
                wait = True
                args = args[1:]
            elif args[0] in ("-m", "--model"):
                if len(args) < 2:
                    sys.exit("-m needs a model name")
                model = args[1]
                args = args[2:]
            else:
                if len(args) < 2:
                    sys.exit("--in needs a directory")
                in_dir = args[1]
                args = args[2:]
        if not args:
            sys.exit("nothing to do; qt help")
        queue(" ".join(args), wait=wait, in_dir=in_dir, model=model)


if __name__ == "__main__":
    main()
