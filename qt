# AppleScript for the quicktask:// URL handler. Validation is strict on
# purpose: anyone can put a quicktask:// link in a Slack message, so the id
# must be lowercase letters, digits, or hyphens (the characters we generate)
# before it goes anywhere near a shell, and it is still shell-quoted after
# that. The qt path and any QT_DATA override are baked in at install time:
# `do shell script` runs a bare sh with none of the user's shell rc.
HANDLER_APPLESCRIPT = """\
on open location theURL
	set prefix to "quicktask://resume/"
	if theURL does not start with prefix then
		display notification "unrecognized link" with title "quicktask"
		return
	end if
	if (length of theURL) is less than or equal to (length of prefix) then
		display notification "empty resume link" with title "quicktask"
		return
	end if
	set tid to text ((length of prefix) + 1) thru -1 of theURL
	set allowed to "abcdefghijklmnopqrstuvwxyz0123456789-"
	considering case
		repeat with c in characters of tid
			if allowed does not contain (c as text) then
				display notification "bad resume link" with title "quicktask"
				return
			end if
		end repeat
	end considering
	try
		do shell script "__SHELL_CMD__" & quoted form of tid
	on error errMsg
		display notification errMsg with title "quicktask resume failed"
	end try
end open location
"""


HANDLER_EXTRA_PATH = "/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin"


def handler_applescript(qt_bin):
    # `do shell script` runs with a minimal PATH and a clean env: extend
    # the PATH so a Homebrew- or ~/.local/bin-installed cmux is findable,
    # and set CMUX_QUIET so its deprecation notice can't look like a
    # failure from the very first hop, before qt's own cmux calls (which
    # already set this too) even run.
    cmd = f'export PATH="{HANDLER_EXTRA_PATH}:$PATH"; '
    cmd += "export CMUX_QUIET=1; "
    if QT_DATA != os.path.expanduser("~/.quicktasks"):
        cmd += "export QT_DATA=" + shlex.quote(QT_DATA) + "; "
    # bake the interpreter too: `do shell script` runs with a minimal PATH,
    # so the shebang's `env python3` may not resolve there
    cmd += (shlex.quote(sys.executable) + " " + shlex.quote(qt_bin)
            + " _resume-launch ")
    esc = cmd.replace("\\", "\\\\").replace('"', '\\"')
    return HANDLER_APPLESCRIPT.replace("__SHELL_CMD__", esc)


def _run_step(argv, timeout):
    """Install-step runner: a missing binary or a hang counts as a plain
    failure, never a traceback."""
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stderr or "").strip()
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError) as e:
        return 1, str(e)

LSREGISTER = ("/System/Library/Frameworks/CoreServices.framework/Frameworks/"
              "LaunchServices.framework/Support/lsregister")


def handler_app_path():
    return os.path.join(QT_DATA, "QuicktaskResume.app")


RESUME_HANDLER_BUNDLE_ID = "com.quicktasks.resume-handler"
LSREGISTER_DUMP_ENV = "QT_TEST_LSREGISTER_DUMP"


def _lsregister_dump_text():
    """Read-only dump of the LaunchServices database. Tests point
    QT_TEST_LSREGISTER_DUMP at a fixture file so this never has to run the
    real lsregister -dump (or, on a machine without one, just fails
    closed and returns "")."""
    fixture = os.environ.get(LSREGISTER_DUMP_ENV)
    if fixture:
        try:
            with open(fixture) as f:
                return f.read()
        except OSError:
            return ""
    try:
        r = subprocess.run([LSREGISTER, "-dump"], capture_output=True,
                            text=True, timeout=30)
        return r.stdout or ""
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        return ""


def _lsregister_claimants(bundle_id, dump_text=None):
    """Parse `lsregister -dump` output for every bundle record whose
    CFBundleIdentifier == bundle_id. Returns a list of
    {"path": str|None, "name": str|None} dicts, in dump order. A pure
    parser: never mutates the LaunchServices database, and dump_text can
    be injected (a fixture, in tests) instead of shelling out at all."""
    if dump_text is None:
        dump_text = _lsregister_dump_text()
    claimants = []
    for block in dump_text.split("-" * 80):
        m = re.search(r"^identifier:\s*(\S+)", block, re.MULTILINE)
        if not m or m.group(1) != bundle_id:
            continue
        path_m = re.search(r"^path:\s*(\S+)", block, re.MULTILINE)
        name_m = re.search(r"^bundle id:\s*(.+?)\s*\(0x[0-9a-fA-F]+\)\s*$", block, re.MULTILINE)
        claimants.append({
            "path": path_m.group(1) if path_m else None,
            "name": name_m.group(1).strip() if name_m else None,
        })
    return claimants


def _sweep_stale_claimants(bundle_id, keep_path, dump_text=None, run_step=None):
    """Unregister (`lsregister -u <path>`) every claimant of bundle_id
    other than keep_path (pass None to sweep everything). Returns a list
    of {"path", "name", "rc"} for every removal attempted. dump_text and
    run_step are injectable so this can be exercised in tests against a
    fixture with a fake runner, never against the real LaunchServices
    database or a real lsregister invocation."""
    if run_step is None:
        run_step = _run_step
    keep_real = os.path.realpath(keep_path) if keep_path else None
    removed = []
    for claimant in _lsregister_claimants(bundle_id, dump_text=dump_text):
        path = claimant.get("path")
        if not path:
            continue
        if keep_real and os.path.realpath(path) == keep_real:
            continue
        rc, _ = run_step([LSREGISTER, "-u", path], 30)
        removed.append({"path": path, "name": claimant.get("name"), "rc": rc})
    return removed


def _handler_baked_paths(app):
    """Best-effort read of the interpreter and qt path baked into the
    installed handler's `do shell script` line. Prefers the plaintext
    AppleScript source qt writes at install time (QT_DATA/tmp/quicktask-
    handler.applescript, left in place after osacompile); falls back to
    decompiling the installed applet's compiled script if that source is
    gone. Both are read-only inspection, never a mutation or a run of the
    handler itself. Returns (interpreter, qt_bin), either side None if it
    can't be determined."""
    text = None
    src = os.path.join(TMP_DIR, "quicktask-handler.applescript")
    if os.path.isfile(src):
        try:
            with open(src) as f:
                text = f.read()
        except OSError:
            text = None
    if text is None:
        script = os.path.join(app, "Contents", "Resources", "Scripts", "main.scpt")
        if os.path.isfile(script):
            try:
                r = subprocess.run(["osadecompile", script], capture_output=True,
                                    text=True, timeout=15)
                text = r.stdout or ""
            except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
                text = ""
        else:
            text = ""
    m = re.search(r'do shell script "((?:[^"\\]|\\.)*)"', text)
    if not m:
        return None, None
    cmd = m.group(1).replace('\\"', '"').replace("\\\\", "\\")
    # strip any number of leading `export NAME=value; ` segments (PATH,
    # CMUX_QUIET, QT_DATA) baked in ahead of the interpreter + qt path
    cmd = re.sub(r'^(?:export\s+[A-Za-z_][A-Za-z0-9_]*=(?:"[^"]*"|\S+);\s*)+', "", cmd)
    cmd = cmd.split("_resume-launch")[0]
    try:
        tokens = shlex.split(cmd)
    except ValueError:
        return None, None
    interp = tokens[0] if tokens else None
    qt_bin = tokens[1] if len(tokens) > 1 else None
    return interp, qt_bin


def _find_cmux_under_minimal_path():
    """What find_cmux() actually resolves to if the calling process has
    only a bare system PATH to search, the way a LaunchServices `do shell
    script` does. Temporarily overrides the real PATH and restores it
    afterward; never leaves the process's PATH changed."""
    minimal = "/usr/bin:/bin:/usr/sbin:/sbin"
    old = os.environ.get("PATH")
    try:
        os.environ["PATH"] = minimal
        return find_cmux()
    finally:
        if old is None:
            os.environ.pop("PATH", None)
        else:
            os.environ["PATH"] = old


def cmd_install_handler():
    """Build and register the quicktask:// URL handler so resume links in
    Slack open the session in the preferred terminal. Lives in QT_DATA;
    remove with qt uninstall-handler."""
    try:
        bootstrap()
    except OSError as e:
        sys.exit(f"data dir not writable: {e}")
    qt_bin = os.path.abspath(__file__)
    if not os.access(qt_bin, os.X_OK):
        sys.exit(f"qt is not executable at {qt_bin}")
    app = handler_app_path()
    # build into a staging bundle and swap only on success, so a failed
    # rebuild cannot destroy a working install (the name must end in .app
    # or osacompile emits a script file instead of a bundle)
    staging = os.path.join(QT_DATA, "QuicktaskResume.new.app")
    src = os.path.join(TMP_DIR, "quicktask-handler.applescript")
    os.makedirs(TMP_DIR, exist_ok=True)
    with open(src, "w") as f:
        f.write(handler_applescript(qt_bin))
    if os.path.isdir(staging):
        shutil.rmtree(staging)
    rc, err = _run_step(["osacompile", "-o", staging, src], 60)
    if rc != 0:
        sys.exit("osacompile failed: " + (err or "unknown error"))

    plist_path = os.path.join(staging, "Contents", "Info.plist")
    with open(plist_path, "rb") as f:
        info = plistlib.load(f)
    info["CFBundleIdentifier"] = "com.quicktasks.resume-handler"
    info["CFBundleURLTypes"] = [{
        "CFBundleURLName": "com.quicktasks.resume",
        "CFBundleURLSchemes": ["quicktask"],
    }]
    info["LSUIElement"] = True  # no Dock icon or focus steal on link clicks
    with open(plist_path, "wb") as f:
        plistlib.dump(info, f)

    # the plist edit invalidates the applet's signature; re-sign ad-hoc
    sign_rc, sign_err = _run_step(["codesign", "--force", "--sign", "-", staging], 30)

    if os.path.isdir(app):
        shutil.rmtree(app)
    os.replace(staging, app)

    # a leftover duplicate registration (an old build, a defunct staging
    # path, anything else still claiming our scheme) is how a resume link
    # silently opens the wrong app; sweep those before registering the
    # fresh one so only it is left claiming the identifier
    swept = _sweep_stale_claimants(RESUME_HANDLER_BUNDLE_ID, app)
    for s in swept:
        status = "ok" if s["rc"] == 0 else f"rc {s['rc']}"
        print(f"removed stale claimant: {s['name'] or '?'} at {s['path']} ({status})")

    registered = _run_step([LSREGISTER, "-f", app], 30)[0] == 0
    if not registered:
        registered = _run_step(["open", "-g", app], 30)[0] == 0

    print(f"handler: {app}")
    print("codesign: " + ("ok" if sign_rc == 0 else
          f"FAILED ({sign_err}); macOS may refuse to launch the handler"))
    print("registered: " + ("ok · scheme quicktask://" if registered else "FAILED"))
    if not registered:
        sys.exit("LaunchServices registration failed; rerun qt install-handler")
    print('test: open "quicktask://resume/<some-task-id>"')
    print("Slack shows a confirmation dialog on the first click.")


def cmd_uninstall_handler():
    app = handler_app_path()
    if not os.path.isdir(app):
        sys.exit("no handler installed")
    # sweep every claimant of the identifier, not just this one bundle, so
    # uninstall actually leaves nothing behind to cause a future mystery
    swept = _sweep_stale_claimants(RESUME_HANDLER_BUNDLE_ID, None)
    for s in swept:
        status = "ok" if s["rc"] == 0 else f"rc {s['rc']}"
        print(f"removed: {s['name'] or '?'} at {s['path']} ({status})")
    shutil.rmtree(app)
    print(f"removed {app} and its quicktask:// registration")


def cmd_doctor():
    """Read-only environment health check. Exits nonzero on a hard failure
    (qt cannot run tasks at all); soft issues are marked "!" with a remedy
    and don't affect the exit code."""
    try:
        bootstrap()  # doctor still needs the data dir to exist to check it
    except OSError:
        pass  # reported below as an unwritable data dir instead of a crash
    hard_fail = False

    def report(status, label, detail="", remedy=None):
        nonlocal hard_fail
        marker = {"ok": "ok", "warn": "!", "fail": "FAIL"}[status]
        if status == "fail":
            hard_fail = True
        print(f"{marker:<4} {label:<22} {detail}".rstrip())
        if remedy:
            print(f"       -> {remedy}")

    claude = find_claude()
    if claude:
        ver = "?"
        try:
            r = subprocess.run([claude, "--version"], capture_output=True, text=True, timeout=10)
            out = (r.stdout or r.stderr or "").strip()
            ver = out.splitlines()[0] if out else "?"
        except Exception:
            pass
        report("ok", "claude CLI", f"{claude} ({ver})")
    else:
        report("fail", "claude CLI", "not found on PATH",
                "install: https://docs.claude.com/en/docs/claude-code")

    writable = os.path.isdir(QT_DATA) and os.access(QT_DATA, os.W_OK)
    report("ok" if writable else "fail", "data dir", QT_DATA,
            None if writable else "check permissions on this directory")

    cfg = load_config()
    if os.path.exists(CONFIG_PATH):
        summary = (f"terminal={cfg.get('terminal', 'Terminal')} · "
                   f"permissions={cfg.get('permissions', 'acceptEdits')} · "
                   f"model={cfg.get('model') or 'inherit'} · "
                   f"trusted={len(cfg.get('trusted_dirs', []))} dir(s) · "
                   f"notifier={cfg.get('notifier', 'osascript')}")
        report("ok", "config", summary)
    else:
        report("warn", "config", "none yet", "run: qt setup")

    term = cfg.get("terminal", "Terminal")
    if term == "cmux":
        cmux = find_cmux()
        if not cmux:
            report("warn", "terminal (cmux)", "binary not found",
                    "install cmux, or qt setup to pick a different terminal")
        else:
            verdict, detail = _cmux_outside_access(cmux)
            if verdict == "ok":
                report("ok", "terminal (cmux)", f"{cmux}, socket responding; outside-cmux probe ok")
            elif verdict == "denied":
                report("warn", "terminal (cmux)", CMUXONLY_SYMPTOM, CMUXONLY_REMEDY)
            elif verdict == "down":
                report("ok", "terminal (cmux)",
                        f"{cmux}, app not running now (resume auto-starts it)")
            else:
                report("warn", "terminal (cmux)",
                        f"{cmux}, socket responding; outside-cmux probe inconclusive ({detail[:80]})",
                        "run qt doctor again; if a resume click still lands in Terminal.app, "
                        "qt resume-log names the reason")
    elif term in ("Ghostty", "iTerm"):
        app_path = f"/Applications/{term}.app"
        if os.path.isdir(app_path):
            report("ok", f"terminal ({term})", app_path)
        else:
            report("warn", f"terminal ({term})", f"{app_path} not found",
                    "install it, or qt setup to pick a different terminal")
    elif term == "Terminal":
        report("ok", "terminal (Terminal)", "built in")
    else:
        report("ok", "terminal (custom)", term)

    tn = find_notifier()
    if tn:
        report("ok", "notifier", f"terminal-notifier · {tn}")
    else:
        report("ok", "notifier",
                "osascript · upgrade: brew install terminal-notifier, then set in qt setup")

    home_local_bin = os.path.expanduser("~/.local/bin")
    on_path = home_local_bin in os.environ.get("PATH", "").split(os.pathsep)
    report("ok" if on_path else "warn", "PATH", home_local_bin,
            None if on_path else "add ~/.local/bin to PATH in your shell rc")

    dirs = cfg.get("trusted_dirs", [])
    if not dirs:
        report("ok", "trusted dirs", "none (everything runs conservative)")
    else:
        for d in dirs:
            gone = not os.path.isdir(os.path.realpath(os.path.expanduser(d)))
            report("warn" if gone else "ok", "trusted dir",
                    d + (" (no longer exists)" if gone else ""),
                    "qt untrust " + d if gone else None)

    hub_dir = resolve_hub_dir()
    if not hub_dir:
        report("ok", "hub feed", "off · qt hub <dir> to feed finished tasks into a Pass ledger")
    elif not os.path.isdir(hub_dir):
        report("warn", "hub feed", f"{hub_dir} (no longer exists)", "qt hub off, or qt hub <dir> to repoint it")
    elif not os.path.isfile(os.path.join(hub_dir, "seed.py")):
        report("warn", "hub feed", f"{hub_dir} (no seed.py)", "check hub_dir points at a Pass checkout")
    else:
        report("ok", "hub feed", hub_dir)

    app = handler_app_path()
    if not os.path.isdir(app):
        report("warn", "resume link handler", "not installed",
               "qt install-handler enables clickable Slack resume links")
    else:
        try:
            with open(os.path.join(app, "Contents", "Info.plist"), "rb") as f:
                schemes = [s for t in plistlib.load(f).get("CFBundleURLTypes", [])
                           for s in t.get("CFBundleURLSchemes", [])]
        except (OSError, plistlib.InvalidFileException):
            schemes = []
        signed = _run_step(["codesign", "--verify", app], 15)[0] == 0
        if "quicktask" in schemes and signed:
            report("ok", "resume link handler", "installed (quicktask://)")
        else:
            report("warn", "resume link handler",
                   "present but " + ("unsigned" if "quicktask" in schemes
                                     else "scheme not registered in bundle"),
                   "qt install-handler to rebuild")

    # resume handler: every LaunchServices claimant of the identifier (a
    # stale duplicate is exactly how a resume link silently opens the
    # wrong app), the baked interpreter/qt paths, and what a `do shell
    # script`'s minimal PATH actually sees for cmux.
    claimants = _lsregister_claimants(RESUME_HANDLER_BUNDLE_ID)
    installed_real = os.path.realpath(app) if os.path.isdir(app) else None
    if not claimants:
        report("warn", "resume handler claimants",
                f"none found for {RESUME_HANDLER_BUNDLE_ID}",
                "qt install-handler, or check lsregister -dump is readable")
    else:
        extra_count = 0
        for c in claimants:
            path = c.get("path")
            is_installed = bool(path and installed_real and os.path.realpath(path) == installed_real)
            if is_installed:
                report("ok", "resume handler claimant", f"{c.get('name') or '?'} · {path} (installed)")
            else:
                extra_count += 1
                report("warn", "resume handler claimant",
                        f"{c.get('name') or '?'} · {path or '(no path)'} (EXTRA)",
                        "qt install-handler now sweeps stale claimants automatically; rerun it, or qt uninstall-handler")
        if extra_count:
            report("warn", "resume handler claimants",
                    f"{extra_count} extra beside the installed one")

    interp, qt_bin_baked = _handler_baked_paths(app) if os.path.isdir(app) else (None, None)
    if interp or qt_bin_baked:
        interp_ok = bool(interp and os.path.exists(interp))
        qt_ok = bool(qt_bin_baked and os.path.exists(qt_bin_baked))
        report("ok" if interp_ok else "warn", "handler baked interpreter",
                interp or "?", None if interp_ok else "rerun qt install-handler")
        report("ok" if qt_ok else "warn", "handler baked qt path",
                qt_bin_baked or "?", None if qt_ok else "rerun qt install-handler")
    elif os.path.isdir(app):
        report("warn", "handler baked paths", "could not be determined",
                "install source/script missing; rerun qt install-handler")

    minimal_cmux = _find_cmux_under_minimal_path()
    cmux_relevant = term == "cmux"
    report("ok" if (not cmux_relevant or minimal_cmux) else "warn",
            "resume terminal",
            f"configured={term} · find_cmux() under minimal PATH -> {minimal_cmux or 'not found'}",
            None if (not cmux_relevant or minimal_cmux) else
            "a resume link's do shell script may not find cmux; put it on a stable PATH "
            "(e.g. /opt/homebrew/bin) or qt setup to pick a different terminal")

    if os.path.exists(RESUME_LOG):
        with open(RESUME_LOG) as f:
            tail = [ln.strip() for ln in f if ln.strip()][-3:]
        if tail:
            print()
            print("last resume launches (qt resume-log for more):")
            for ln in tail:
                print("    " + ln)
    else:
        report("ok", "resume launches", "none logged yet")

    print()
    print("hard failures found; qt cannot run tasks" if hard_fail else "no hard failures")
    if hard_fail:
        sys.exit(1)


